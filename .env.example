# Copy to .env.local for local development. Never commit real values.
# Every variable here is read on the server only; none is exposed to the browser.

# Public origin of the app. Used for OAuth redirect URIs and same-origin checks.
APP_URL=http://localhost:3000

# --- App sign-in (Auth.js + Google, identity scopes only) ---
# Generate with: openssl rand -base64 33
AUTH_SECRET=
# Google OAuth client (Web application). Also used for the separate read-only calendar grant.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# The single Google account allowed to sign in. Everyone else is rejected.
ALLOWED_EMAIL=

# --- Operational store (runs, locks, briefings, audit, encrypted tokens) ---
# Postgres connection string. Required in production.
# Leave blank locally to use the embedded store in ./.data/pglite.
DATABASE_URL=
# 32 random bytes, base64. Encrypts Google refresh tokens at rest.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- Notion (authoritative task database) ---
# Read content is enough for briefings. Chat task updates also need Insert content and Update content,
# and only run after you turn on "Task updates from chat" in the app.
NOTION_TOKEN=
# Preferred: the data source id printed by `npm run notion:setup`.
NOTION_DATA_SOURCE_ID=
# Alternative: a database id; its first data source is used.
NOTION_DATABASE_ID=
# Only needed by `npm run notion:setup` to create the database.
NOTION_PARENT_PAGE_ID=

# --- Scheduler ---
# At least 16 characters. Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Optional external intake (POST /api/intake) ---
# Leave blank to disable the endpoint (it returns 404). At least 32 characters.
# Generate with: openssl rand -hex 32
INTAKE_TOKEN=

# --- Optional AI (briefing wording and chat extraction; both work without it) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
